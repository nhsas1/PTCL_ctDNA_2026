# Large sequencing data files — never commit
*.bam
*.bai
*.fastq
*.fastq.gz
*.fq
*.fq.gz
*.cram

# Large output files
bam_qc_report.txt
slurm_*.log
slurm_*.err

# R temporary files
.Rhistory
.RData
.Rproj.user/

# Conda environments
*.conda
envs/

# System files
.DS_Store
__pycache__/

# Any file with patient metadata
*metadata*clinical*
*patient_ids*

# ichorCNA large outputs — never push these
# (*.bam and *.bai are already covered by the sequencing data rules above)
*.wig
*.RData
*_CNA_chr*.pdf
*_genomeWide*.pdf
*_bias.pdf
*_correct.pdf
*_tpdf.pdf
*_all_sols.pdf
*.cna.seg
*.correctedDepth.txt
*.OLD_JUNE17_BACKUP
*.ORIGINAL
*.bak_*

# Exception: the pre-curation state of the three manually corrected samples is kept
# deliberately. These are provenance for the curation decisions, not stray backups —
# without them there is no record of what the ichorCNA calls were before intervention.
!results/ichorCNA/corrected_seg_files/originals_backup/*.ORIGINAL
